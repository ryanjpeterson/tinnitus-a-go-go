# Copy to .env for local dev. Never commit .env.
# Generate secrets with: openssl rand -base64 32

NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# Postgres
POSTGRES_USER=tagg
POSTGRES_PASSWORD=tagg_dev_password
POSTGRES_DB=tagg
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://tagg:tagg_dev_password@db:5432/tagg

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=tagg_minio
MINIO_ROOT_PASSWORD=tagg_minio_dev_password
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=tagg-media
# Public URL browsers use to fetch presigned URLs. Must be reachable from the
# user's browser. In dev: http://localhost:9000. In prod: your CDN / S3 domain.
# Public base URL browsers use to load media. Must be reachable from the user's
# browser. Media is proxied through the app server (/tagg-media/ path), so this
# should be the app's own base URL — NOT the raw MinIO port.
#   Dev:              http://localhost:5173
#   Tailscale (LAN):  http://100.x.x.x:5173
#   Tailscale Funnel: https://macmini.stingray-octatonic.ts.net
MINIO_PUBLIC_URL=http://localhost:5173

# Mailpit (dev SMTP capture)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM="Tinnitus A Go Go <no-reply@tinnitusagogo.local>"

# Sessions
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace_me_with_long_random_string_at_least_32_bytes
SESSION_COOKIE_NAME=tagg_session
SESSION_TTL_DAYS=30

# Invite system
INVITES_PER_USER=3
INVITE_TTL_DAYS=14

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# CORS — comma-separated origins allowed to call the API
# For local dev only:
CORS_ORIGINS=http://localhost:5173
# For Tailscale access from macmini / macbookair, add your Tailscale IP:
#   CORS_ORIGINS=http://localhost:5173,http://100.x.x.x:5173
# Get your Tailscale IP with: tailscale ip -4

# ── Tailscale / remote access ──────────────────────────────────────────────
# When serving over Tailscale, also update these two:
#   MINIO_PUBLIC_URL=http://100.x.x.x:9000    ← so media URLs resolve on other devices
#   APP_URL=http://100.x.x.x:5173             ← used in email links
#
# Then start with the overlay:
#   docker compose -f docker-compose.yml -f docker-compose.tailscale.yml up -d
# See docker-compose.tailscale.yml for full setup instructions.

# Setlist.fm API key — optional, enables concert prefill in Add Show modal.
# Get a free key at https://api.setlist.fm/docs/1.0/ (register → "Edit Profile" → "API Key")
SETLISTFM_API_KEY=

# Last.fm API key — optional, enables artist data enrichment (bio, images, genres).
# Get a free key at https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Admin services panel — shown on the dashboard to admin users.
# Set to the correct URL for each environment.
# Dev:  VITE_MINIO_CONSOLE_URL=http://localhost:9001
# Prod: VITE_MINIO_CONSOLE_URL=http://100.x.x.x:9001
VITE_MINIO_CONSOLE_URL=http://localhost:9001
# Mailpit is dev-only — leave blank in prod
VITE_MAILPIT_URL=http://localhost:8025

# Backup destination — used by scripts/backup.sh
# Set to your external drive path on the production machine, e.g.:
#   /Volumes/SamsungT7/tagg-backups
# Leave blank on dev machines (backup script is prod-only)
TAGG_BACKUP_DIR=
